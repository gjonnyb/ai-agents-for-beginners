# LLM API Keys (at least one required for AI agents)
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Alpaca (stocks/ETFs) - https://app.alpaca.markets/
ALPACA_API_KEY=your-alpaca-key-here
ALPACA_SECRET_KEY=your-alpaca-secret-here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# CCXT (crypto) - exchange-specific credentials
CCXT_EXCHANGE=binance
CCXT_API_KEY=your-exchange-key-here
CCXT_SECRET=your-exchange-secret-here

# Risk Management Defaults
DEFAULT_RISK_PER_TRADE=0.02
MAX_PORTFOLIO_DRAWDOWN=0.10
MAX_CONCURRENT_POSITIONS=6
MAX_POSITION_SIZE_PCT=0.15

# Trading Mode: research | backtest | paper | live
TRADING_MODE=paper
